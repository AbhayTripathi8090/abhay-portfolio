# Gmail address used to send portfolio contact-form emails.
SMTP_USER=your-gmail-address@gmail.com
# Gmail App Password (not your normal Gmail password).
SMTP_PASS=your-16-character-app-password
# Inbox that receives portfolio contact-form emails.
CONTACT_TO_EMAIL=your-gmail-address@gmail.com
# GA4 measurement ID used by the client-side Google Analytics script.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
